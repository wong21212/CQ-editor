import cadquery as cq
import math

# Parameters
base_width = 12.0
depth = 5.0
angle_deg = 8
length = 20.0
clearance = 0.2

# Derived
angle_rad = math.radians(angle_deg)
top_width = base_width - 2 * math.tan(angle_rad) * depth

# Male dovetail
male = (
    cq.Workplane("XY")
    .polyline([
        (0, 0),
        (base_width, 0),
        ((base_width + top_width) / 2, depth),
        ((base_width - top_width) / 2, depth),
        (0, 0)
    ])
    .close()
    .extrude(length)
)

# Female dovetail
top_width_f = base_width + 2 * math.tan(angle_rad) * depth + clearance
female = (
    cq.Workplane("XY")
    .polyline([
        (0, 0),
        (base_width + clearance, 0),
        (((base_width + top_width_f) / 2), depth + clearance),
        (((base_width - top_width_f) / 2), depth + clearance),
        (0, 0)
    ])
    .close()
    .extrude(length)
)

# Export
cq.exporters.export(male, "male_dovetail.stl")
cq.exporters.export(female, "female_dovetail.stl")
